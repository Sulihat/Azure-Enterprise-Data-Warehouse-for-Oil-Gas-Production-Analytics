-- ACTUAL PRODUCTION TABLE

CREATE TABLE ActualProduction (
    ActualProductionID BIGINT IDENTITY PRIMARY KEY,
    ProductionDate DATE,
    WellID INT,
    ProductType VARCHAR(20),         -- Oil / Gas
    VolumeProduced DECIMAL(18,2),
    UnitOfMeasure VARCHAR(10),
    OperatingHours INT,
    FOREIGN KEY (WellID) REFERENCES Well(WellID)
);

WITH DateSeries AS (
    SELECT CAST('2022-01-01' AS DATE) AS ProductionDate
    UNION ALL
    SELECT DATEADD(DAY, 1, ProductionDate)
    FROM DateSeries
    WHERE ProductionDate < CAST(GETDATE() AS DATE)
)
INSERT INTO ActualProduction
(ProductionDate, WellID, ProductType, VolumeProduced, UnitOfMeasure, OperatingHours)
SELECT
    d.ProductionDate,
    w.WellID,
    CASE 
        WHEN f.HydrocarbonType = 'Gas' THEN 'Gas'
        ELSE 'Oil'
    END,
    CASE 
        WHEN f.HydrocarbonType = 'Gas' 
            THEN ROUND(20 + RAND(CHECKSUM(NEWID())) * 10, 2)
        ELSE 
            ROUND(800 + RAND(CHECKSUM(NEWID())) * 500, 2)
    END,
    CASE 
        WHEN f.HydrocarbonType = 'Gas' THEN 'mmscf'
        ELSE 'bbl'
    END,
    22
FROM DateSeries d
CROSS JOIN Well w
JOIN Field f ON w.FieldID = f.FieldID
OPTION (MAXRECURSION 0);


-- TARGET (EXPECTED) PRODUCTION TABLE

CREATE TABLE TargetProduction (
    TargetProductionID BIGINT IDENTITY PRIMARY KEY,
    ProductionDate DATE,
    WellID INT,
    ProductType VARCHAR(20),
    ExpectedVolume DECIMAL(18,2),
    UnitOfMeasure VARCHAR(10),
    PlannedOperatingHours INT,
    FOREIGN KEY (WellID) REFERENCES Well(WellID)
);

WITH DateSeries AS (
    SELECT CAST('2022-01-01' AS DATE) AS ProductionDate
    UNION ALL
    SELECT DATEADD(DAY, 1, ProductionDate)
    FROM DateSeries
    WHERE ProductionDate < CAST(GETDATE() AS DATE)
)
INSERT INTO TargetProduction
(ProductionDate, WellID, ProductType, ExpectedVolume, UnitOfMeasure, PlannedOperatingHours)
SELECT
    d.ProductionDate,
    w.WellID,
    CASE 
        WHEN f.HydrocarbonType = 'Gas' THEN 'Gas'
        ELSE 'Oil'
    END,
    CASE 
        WHEN f.HydrocarbonType = 'Gas' THEN 30.00
        ELSE 1200.00
    END,
    CASE 
        WHEN f.HydrocarbonType = 'Gas' THEN 'mmscf'
        ELSE 'bbl'
    END,
    24
FROM DateSeries d
CROSS JOIN Well w
JOIN Field f ON w.FieldID = f.FieldID
OPTION (MAXRECURSION 0);


