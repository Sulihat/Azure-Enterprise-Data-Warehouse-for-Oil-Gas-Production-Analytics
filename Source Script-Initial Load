-- WELL TABLE

CREATE TABLE Well (
    WellID INT IDENTITY PRIMARY KEY,
    WellName VARCHAR(50),
    WellType VARCHAR(30),            -- Production
    FieldID INT,
    FacilityID INT,
    Status VARCHAR(20),
    FOREIGN KEY (FieldID) REFERENCES Field(FieldID),
    FOREIGN KEY (FacilityID) REFERENCES Facility(FacilityID)
);

