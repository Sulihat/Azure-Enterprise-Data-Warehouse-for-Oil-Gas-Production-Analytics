
-- FIELD TABLE

CREATE TABLE Field (
    FieldID INT IDENTITY PRIMARY KEY,
    FieldCode VARCHAR(20),
    FieldName VARCHAR(100),
    HydrocarbonType VARCHAR(20),   -- Oil, Gas, Oil & Gas
    Location VARCHAR(100),
    OnshoreOffshore VARCHAR(20),
    DiscoveryYear INT
);

