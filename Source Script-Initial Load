-- FACILITY TABLE

CREATE TABLE Facility (
    FacilityID INT IDENTITY PRIMARY KEY,
    FacilityName VARCHAR(100),
    FacilityType VARCHAR(50),       -- FPSO, Gas Plant, Flow Station
    FieldID INT,
    FOREIGN KEY (FieldID) REFERENCES Field(FieldID)
);

