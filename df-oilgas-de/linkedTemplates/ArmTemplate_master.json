{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-oilgas-de"
		},
		"SinkAdls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'SinkAdls'"
		},
		"sourcedb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sourcedb'"
		},
		"SinkAdls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://oilgasprod.dfs.core.windows.net/"
		},
		"sourcedb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "oilgas-sql-server.database.windows.net"
		},
		"sourcedb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "OilGas_ProductionDB"
		},
		"sourcedb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladminuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-oilgas-de_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"SinkAdls_accountKey": {
						"value": "[parameters('SinkAdls_accountKey')]"
					},
					"sourcedb_password": {
						"value": "[parameters('sourcedb_password')]"
					},
					"SinkAdls_properties_typeProperties_url": {
						"value": "[parameters('SinkAdls_properties_typeProperties_url')]"
					},
					"sourcedb_properties_typeProperties_server": {
						"value": "[parameters('sourcedb_properties_typeProperties_server')]"
					},
					"sourcedb_properties_typeProperties_database": {
						"value": "[parameters('sourcedb_properties_typeProperties_database')]"
					},
					"sourcedb_properties_typeProperties_userName": {
						"value": "[parameters('sourcedb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}